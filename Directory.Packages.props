<Project>
  <!-- All versions pinned. Avalonia 12.1.3 targets net10.0 and depends on SkiaSharp 3.119.4
       (verified from nuspec on api.nuget.org, 2026-10-07). -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- Silk.NET.SDL 2.23.0 (MIT) pulls Ultz.Native.SDL 2.32.10 (zlib): SDL2 natives for win/linux/osx. -->
    <PackageVersion Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>
</Project>
